[Unit]
# {{ ansible_managed }}
Description=Nautobot WSGI Service (uWSGI)
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
Type=simple
User={{ server_user }}
Group={{ server_group }}
WorkingDirectory={{ server_root }}
EnvironmentFile={{ server_root }}/nautobot.env
Environment=NAUTOBOT_ROOT={{ server_root }}
ExecStart={{ server_root }}/bin/nautobot-server start --ini {{ server_root }}/uwsgi.ini
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
